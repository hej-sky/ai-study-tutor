# 统一换行符，避免 Windows(CRLF) 与 Linux(LF) 混用导致整文件 diff
* text=auto eol=lf

*.md    text eol=lf
*.html   text eol=lf
*.py     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.svg  text eol=lf
